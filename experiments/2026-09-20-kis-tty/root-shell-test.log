=== ram_io ===
testdir=$(mktemp -d /tmp/kis-shell-test.XXXXXX) && printf 'KIS root shell RAM test\n' > "$testdir/input" && cp "$tes
tdir/input" "$testdir/copy" && cmp "$testdir/input" "$testdir/copy" && dd if=/dev/zero of="$testdir/zeros" bs=1M count=1
6 2>/dev/null && test "$(wc -c < "$testdir/zeros")" -eq 16777216 && echo RAM_IO_PASS; rm -f "$testdir/input" "$testdir/c
opy" "$testdir/zeros"; rmdir "$testdir"; result=$?; printf '\n%s:%s\n' 'KIS_TEST_RAM_IO_END' "$result"
RAM_IO_PASS

KIS_TEST_RAM_IO_END:0
