=== process_pipe ===
printf 'gamma\nalpha\nbeta\n' | sort; sh -c 'exit 7'; test $? -eq 7 && echo EXIT_STATUS_PASS; sleep 1 & child=$!; wa
it "$child"; echo CHILD_WAIT_STATUS=$?; result=$?; printf '\n%s:%s\n' 'KIS_TEST_PROCESS_PIPE_END' "$result"
alpha
beta
gamma
EXIT_STATUS_PASS
CHILD_WAIT_STATUS=0

